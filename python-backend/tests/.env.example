# Test Configuration Environment Variables
# Copy to .env and modify as needed

# Service URLs
TEST_BASE_URL=http://localhost:8000
TEST_GATEWAY_URL=http://localhost:8000
TEST_ASR_VLLM_URL=http://localhost:8002
TEST_TRANSLATE_VLLM_URL=http://localhost:8005

# Service Ports
TEST_GATEWAY_PORT=8000
TEST_ASR_VLLM_PORT=8002
TEST_TRANSLATE_VLLM_PORT=8005

# Timeouts (seconds)
TEST_REQUEST_TIMEOUT=30
TEST_PIPELINE_TIMEOUT=120
TEST_MODEL_LOAD_TIMEOUT=180

# Test Audio Configuration
TEST_AUDIO_DURATION=1.0
TEST_AUDIO_SAMPLE_RATE=16000
TEST_AUDIO_FREQUENCY=440

# Test Behavior
SKIP_SLOW_TESTS=false
TEST_VERBOSE=false

# Retry Configuration
TEST_MAX_RETRIES=3
TEST_RETRY_DELAY=1.0
